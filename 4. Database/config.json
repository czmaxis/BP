{
  "category": "04-database",
  "tempDir": "./temp",
  "resultsDir": "./results",
  "benchmark": {
    "warmupIterations": 10,
    "measuredIterations": 30
  },
  "docker": {
    "cpus": "2",
    "memory": "2g",
    "memorySwap": "2g"
  },
  "scenarios": {
