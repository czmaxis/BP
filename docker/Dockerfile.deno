# Oficiální obraz Deno postavený na Debianu (stejný základ libc jako u Node.js a Bun)
FROM denoland/deno:debian

WORKDIR /app

# Kopírování konfigurace a zdrojových kódů benchmarku
COPY package.json config.json runner.js compare.js ./
COPY core ./core
COPY scenarios ./scenarios

# Vytvoření interního adresáře temp/ (uvnitř kontejneru) a results/ (pro svazek)
RUN mkdir -p /app/temp /app/results && chmod -R 777 /app/temp /app/results

# Předkompilování / cache TypeScript scénáře při sestavení obrazu
RUN deno cache scenarios/02-file-io/deno.ts

# Výchozí příkaz s explicitními oprávněními pro čtení, zápis a systémové informace
CMD ["deno", "run", "--allow-read", "--allow-write", "--allow-sys", "scenarios/02-file-io/deno.ts"]

