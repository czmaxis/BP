# Oficiální obraz Bun se zafixovanou verzí (stejný základ Debian libc jako u Node.js a Deno)
FROM oven/bun:1.4.4-debian

WORKDIR /app

COPY package.json config.json runner.js compare.js ./
COPY core ./core
COPY scenarios ./scenarios

RUN mkdir -p /app/results && chmod -R 777 /app/results

ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

CMD ["bun", "run", "scenarios/01-http/bun.ts", "--host=0.0.0.0", "--port=3000"]
