{
  "name": "js-runtime-benchmarks-cpu",
  "version": "1.0.0",
  "description": "Benchmarková sada pro analýzu běhových prostředí JavaScriptových aplikací (Node.js, Deno, Bun) - Kategorie 3: CPU-náročné úlohy",
  "type": "module",
  "main": "runner.js",
  "scripts": {
    "start": "node runner-all.js",
    "bench": "node runner-all.js",
    "bench:all": "node runner-all.js",
    "bench:all:quick": "node runner-all.js --quick",
    "bench:node": "node runner.js",
    "bench:node:quick": "node runner.js --quick",
    "bench:deno": "deno run --allow-read --allow-write --allow-sys scenarios/03-cpu/deno.ts",
    "bench:deno:quick": "deno run --allow-read --allow-write --allow-sys scenarios/03-cpu/deno.ts --quick",
    "bench:bun": "bun run scenarios/03-cpu/bun.ts",
    "bench:bun:quick": "bun run scenarios/03-cpu/bun.ts --quick",
    "bench:cpu:crypto": "node runner-all.js --scenario=crypto",
    "bench:cpu:json": "node runner-all.js --scenario=json",
    "bench:cpu:matrix": "node runner-all.js --scenario=matrix",
    "benchmark:docker": "node runner-docker.js",
    "benchmark:docker:quick": "node runner-docker.js --quick",
    "benchmark:docker:node": "node runner-docker.js --runtime=node",
    "benchmark:docker:deno": "node runner-docker.js --runtime=deno",
    "benchmark:docker:bun": "node runner-docker.js --runtime=bun",
    "compare": "node compare.js",
    "clean:results": "node -e \"import('node:fs/promises').then(fs => fs.rm('./results', { recursive: true, force: true }))\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "",
  "license": "MIT"
}
