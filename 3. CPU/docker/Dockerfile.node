# Oficiální odlehčený obraz Node.js 22 (Debian Bookworm Slim)
FROM node:22.9.0-bookworm-slim

WORKDIR /app

COPY package.json config.json runner.js compare.js ./
COPY core ./core
COPY scenarios ./scenarios

RUN mkdir -p /app/results && chmod -R 777 /app/results

ENV NODE_ENV=production

CMD ["node", "scenarios/03-cpu/node.mjs"]
