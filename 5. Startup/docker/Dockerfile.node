# Oficiální odlehčený obraz Node.js 22 (Debian Bookworm Slim)
FROM node:22.9.0-bookworm-slim

WORKDIR /app

COPY package.json config.json runner.js compare.js ./
COPY core ./core
COPY scenarios ./scenarios

RUN mkdir -p /app/results && chmod -R 777 /app/results

# Předehřátí ověřením obou testovacích skriptů během sestavení obrazu
RUN node scenarios/05-startup/node-minimal.mjs && \
    node --experimental-strip-types --no-warnings scenarios/05-startup/node-realistic.ts

ENV NODE_ENV=production

CMD ["node", "runner.js", "--runtime=node"]
