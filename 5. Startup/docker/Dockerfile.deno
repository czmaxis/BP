# Oficiální obraz Deno se zafixovanou verzí (stejný základ Debian libc jako u Node.js a Bun)
FROM denoland/deno:debian-2.9.8

WORKDIR /app

ENV DENO_DIR=/app/.deno_cache

COPY package.json config.json runner.js compare.js ./
COPY core ./core
COPY scenarios ./scenarios

RUN mkdir -p /app/results /app/.deno_cache && chmod -R 777 /app/results /app/.deno_cache

# Předehřátí interní cache DENO_DIR během buildu obrazu, aby první spuštění v kontejneru
# nekompilovalo ani nestahovalo metadata
RUN deno cache scenarios/05-startup/deno-minimal.ts scenarios/05-startup/deno-realistic.ts && \
    deno run scenarios/05-startup/deno-minimal.ts && \
    deno run scenarios/05-startup/deno-realistic.ts

CMD ["deno", "run", "--allow-read", "--allow-write", "--allow-run", "--allow-sys", "--allow-env", "runner.js", "--runtime=deno"]
